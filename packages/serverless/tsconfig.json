{
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "esModuleInterop": true,
        "jsx": "react-jsx",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "outDir": "./lib",
        "rootDir": "./src",
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": "ES2023",
        "types": ["node"],
        "verbatimModuleSyntax": true
    },
    "exclude": ["node_modules", "lib"],
    "include": ["src/**/*"]
}
