{
    "name": "@dextinity/site-nextjs",
    "version": "10.15.0",
    "description": "Dextinity Site Next.js package",
    "repository": {
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity",
        "directory": "packages/site/site-nextjs"
    },
    "license": "BSD-2-Clause",
    "sideEffects": [
        "**/*.css"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js"
        },
        "./build-assets": {
            "types": "./lib/buildAssets.d.ts",
            "default": "./lib/buildAssets.js"
        },
        "./css": "./lib/style.css",
        "./server": {
            "types": "./lib/server.d.ts",
            "import": "./lib/server.js"
        },
        "./webpackPersistedQueriesLoader": "./lib/persistedQueries/webpackPersistedQueriesLoader.js"
    },
    "bin": {
        "dextinity-upload-build-assets": "bin/upload-build-assets.mjs"
    },
    "files": [
        "bin/**/*.mjs",
        "lib/*"
    ],
    "scripts": {
        "build": "pnpm run clean && pnpm run generate-block-types && vite build",
        "clean": "rimraf lib 'src/**/*.generated.ts'",
        "dev": "pnpm run clean && pnpm run generate-block-types && vite build --watch",
        "generate-block-types": "dextinity generate-block-types",
        "generate-block-types:watch": "chokidar -s \"block-meta.json\" -c \"pnpm run generate-block-types\"",
        "lint": "pnpm run generate-block-types && run-p lint:prettier lint:eslint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:prettier": "pnpm exec prettier --check '*.{ts,js,json,md,yml,yaml,css,scss}'",
        "lint:tsc": "tsc --noEmit",
        "test": "pnpm run test:unit",
        "test:unit": "vitest --run",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "@dextinity/site-react": "workspace:*",
        "clsx": "^2.1.1",
        "commander": "^15.1.0",
        "fast-equals": "^6.2.2",
        "jose": "^6.2.16",
        "mime": "^4.1.2",
        "scroll-into-view-if-needed": "^3.1.0",
        "server-only": "^0.0.1",
        "usehooks-ts": "^3.1.1"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "^3.1164.0",
        "@azure/storage-blob": "^12.34.0",
        "@dextinity/cli": "workspace:*",
        "@dextinity/eslint-config": "workspace:*",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "aws-sdk-client-mock": "^4.1.0",
        "chokidar-cli": "^3.0.0",
        "eslint": "^9.39.5",
        "jsdom": "^28.1.0",
        "next": "^16.4.5",
        "npm-run-all2": "^9.0.4",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "rimraf": "^6.1.4",
        "rollup": "^4.68.0",
        "rollup-plugin-preserve-directives": "^0.4.0",
        "sass": "^1.108.1",
        "typescript": "^5.9.3",
        "unplugin-dts": "^1.1.2",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    },
    "peerDependencies": {
        "@aws-sdk/client-s3": "^3.0.0",
        "@azure/storage-blob": "^12.0.0",
        "next": "^14.2.0 || ^15.0.0 || ^16.0.0",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "@aws-sdk/client-s3": {
            "optional": true
        },
        "@azure/storage-blob": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    }
}
