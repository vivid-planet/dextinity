{
    "name": "dextinity-demo-api",
    "private": true,
    "description": "Dextinity API Demo Application",
    "type": "commonjs",
    "scripts": {
        "api-generator": "rimraf --glob 'src/**/generated' && dextinity-api-generator generate",
        "api-generator:watch": "rimraf --glob 'src/**/generated' && dextinity-api-generator generate --watch",
        "build": "pnpm run clean && pnpm run intl:compile && pnpm api-generator && pnpm run generate-block-types && nest build",
        "check-node-version": "check-node-version --node $(cat ../../.nvmrc)",
        "clean": "rimraf dist",
        "console": "NODE_OPTIONS='--max-old-space-size=256' dotenv -e .env.secrets -e .env.local -e .env -e .env.site-configs -- ts-node --transpile-only -r tsconfig-paths/register src/console.ts",
        "console:prod": "node dist/console.js",
        "db:migrate": "pnpm console migrate --",
        "db:migrate:prod": "pnpm console:prod migrate --",
        "dev:nest": "pnpm run clean && pnpm intl:compile && pnpm db:migrate && pnpm console createBlockIndexViews && NODE_OPTIONS='--max-old-space-size=1024' dotenv -e .env.secrets -e .env.local -e .env -e .env.site-configs -- nest start --debug --watch --preserveWatchOutput",
        "dev:reload": "rimraf src/reload.ts && chokidar \"node_modules/@dextinity/cms-api/lib/**\" \"node_modules/@dextinity/brevo-api/lib/**\" -s -c \"echo '// change' >> src/reload.ts\"",
        "fixtures": "pnpm console fixtures --",
        "fixtures:prod": "pnpm console:prod fixtures --",
        "generate-block-types": "dextinity generate-block-types",
        "generate-block-types:watch": "chokidar -s \"block-meta.json\" -c \"pnpm generate-block-types\"",
        "intl:compile": "pnpm run intl:compile:dextinity-demo",
        "intl:compile:dextinity-demo": "formatjs compile-folder --format simple --ast lang/dextinity-demo-lang/api lang-compiled/dextinity-demo-api",
        "intl:extract": "formatjs extract \"src/**/*.ts*\" --ignore '**/*.{test,spec}.{ts,tsx}' --ignore ./**.d.ts --out-file lang-extracted/en.json --format simple --throws",
        "lint": "pnpm run api-generator && pnpm run intl:compile && pnpm run generate-block-types && run-p lint:prettier lint:eslint lint:tsc lint:api-can-start",
        "lint:api-can-start": "MIKRO_ORM_NO_CONNECT=true dotenv -e ../../.env -e ../.env.site-configs -- ts-node --transpile-only -r tsconfig-paths/register src/console.ts --help",
        "lint:ci": "pnpm run api-generator && pnpm run intl:compile && pnpm run generate-block-types && run-p lint:prettier lint:eslint lint:tsc lint:api-can-start && pnpm run lint:generated-files-not-modified",
        "lint:eslint": "eslint --max-warnings 0 src/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:generated-files-not-modified": "git diff --exit-code HEAD -- schema.gql block-meta.json $(find src -type f -path '*/generated/*')",
        "lint:prettier": "pnpm exec prettier --check '*.{ts,js,json,md,yml,yaml}'",
        "lint:tsc": "tsc --project ./tsconfig.lint.json",
        "mikro-orm": "dotenv -e .env.secrets -e .env.local -e .env -e .env.site-configs -- mikro-orm",
        "repl": "pnpm run start --entryFile repl",
        "start": "pnpm run clean && pnpm intl:compile && pnpm run generate-block-types && dotenv -e .env.secrets -e .env.local -e .env -e .env.site-configs -- nest start --debug --watch --preserveWatchOutput",
        "start:dev": "pnpm check-node-version && pnpm run generate-block-types && run-p dev:*",
        "start:prod": "node dist/main",
        "storybook": "storybook dev -p 4004 --no-open --disable-telemetry",
        "test": "pnpm run test:unit",
        "test:unit": "pnpm api-generator && vitest --run",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "@apollo/server": "^5.5.1",
        "@as-integrations/express5": "^1.1.2",
        "@dextinity/brevo-api": "workspace:*",
        "@dextinity/cms-api": "workspace:*",
        "@dextinity/mail-react": "workspace:*",
        "@faker-js/faker": "^10.4.0",
        "@kubernetes/client-node": "^1.4.0",
        "@mikro-orm/cli": "^6.6.14",
        "@mikro-orm/core": "^6.6.14",
        "@mikro-orm/migrations": "^6.6.14",
        "@mikro-orm/nestjs": "^6.1.2",
        "@mikro-orm/postgresql": "^6.6.14",
        "@nestjs/apollo": "^13.4.0",
        "@nestjs/common": "^11.1.21",
        "@nestjs/core": "^11.1.21",
        "@nestjs/graphql": "^13.4.0",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/platform-express": "^11.1.21",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/auto-instrumentations-node": "^0.75.0",
        "@opentelemetry/exporter-prometheus": "^0.217.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
        "@opentelemetry/sdk-node": "^0.217.0",
        "@sentry/node": "^9.47.1",
        "change-case": "^5.4.4",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "cli-progress": "^3.12.0",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "date-fns": "^4.4.0",
        "express": "^5.2.1",
        "graphql": "^16.14.2",
        "graphql-scalars": "^1.25.0",
        "helmet": "^8.1.0",
        "nest-commander": "^3.20.1",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-intl": "^7.1.11",
        "reflect-metadata": "^0.2.2",
        "response-time": "^2.3.4",
        "rxjs": "^7.8.2",
        "slugify": "^1.6.9",
        "uuid": "^11.1.1"
    },
    "devDependencies": {
        "@dextinity/api-generator": "workspace:*",
        "@dextinity/cli": "workspace:*",
        "@dextinity/eslint-config": "workspace:*",
        "@formatjs/cli": "^6.7.4",
        "@nestjs/cli": "^11.0.21",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.1.21",
        "@storybook/addon-docs": "^10.3.5",
        "@storybook/react-vite": "^10.3.5",
        "@types/cli-progress": "^3.11.6",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/inquirer": "^8.2.12",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "@types/response-time": "^2.3.9",
        "check-node-version": "^4.2.1",
        "chokidar-cli": "^3.0.0",
        "dotenv-cli": "^9.0.0",
        "eslint": "^9.39.4",
        "eslint-plugin-storybook": "^10.3.5",
        "npm-run-all2": "^8.0.4",
        "prettier": "^3.6.2",
        "rimraf": "^6.1.2",
        "storybook": "^10.3.5",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^3.15.0",
        "typescript": "^5.9.3",
        "vite-tsconfig-paths": "^6.0.4",
        "vitest": "^4.1.8"
    },
    "mikro-orm": {
        "configPaths": [
            "./src/db/ormconfig.cli.ts",
            "./dist/db/ormconfig.cli.js"
        ],
        "useTsNode": true
    }
}
