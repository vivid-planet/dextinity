{
    "name": "dextinity-demo-admin",
    "private": true,
    "description": "Dextinity Admin Demo Application",
    "type": "commonjs",
    "scripts": {
        "admin-generator": "rimraf --glob 'src/**/generated' && dextinity-admin-generator generate",
        "build": "run-s admin-generator intl:compile && run-p gql:types generate-block-types && NODE_ENV=production vite build",
        "check-node-version": "check-node-version --node $(cat ../../.nvmrc)",
        "generate-block-types": "dextinity generate-block-types --inputs",
        "generate-block-types:watch": "chokidar -s \"block-meta.json\" -c \"pnpm run generate-block-types\"",
        "gql:types": "graphql-codegen",
        "gql:watch": "graphql-codegen --watch",
        "intl:compile": "run-p intl:compile:dextinity intl:compile:dextinity-demo",
        "intl:compile:dextinity": "formatjs compile-folder --format simple --ast lang/dextinity-lang lang-compiled/dextinity-lang",
        "intl:compile:dextinity-demo": "formatjs compile-folder --format simple --ast lang/dextinity-demo-lang/admin lang-compiled/dextinity-demo-lang-admin",
        "intl:extract": "formatjs extract \"src/**/*.{ts,tsx}\" --ignore '**/*.{test,spec}.{ts,tsx}' --ignore ./**.d.ts --out-file lang-extracted/en.json --format simple",
        "lint": "run-s admin-generator intl:compile && run-p gql:types generate-block-types && run-p lint:prettier lint:oxlint lint:tsc intl:extract",
        "lint:ci": "run-s admin-generator intl:compile && run-p gql:types generate-block-types && run-p lint:prettier lint:oxlint lint:tsc lint:generated-files-not-modified",
        "lint:fix": "run-p lint:fix:oxlint lint:fix:prettier",
        "lint:fix:oxlint": "pnpm run lint:oxlint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:generated-files-not-modified": "git diff --exit-code HEAD -- $(find src -type f -path '*/generated/*')",
        "lint:oxlint": "oxlint --config oxlint.config.mts --max-warnings 0 src/",
        "lint:prettier": "pnpm exec prettier --check \"*.{ts,js,json,md,yml,yaml}\" \"src/**/*.{ts,tsx,js,jsx,json}\" \"!src/**/generated/**\" \"!src/**/*.generated.ts\"",
        "lint:tsc": "tsc --project . && tsc --project server",
        "preview": "pnpm run build && vite preview",
        "serve": "node server/index.ts",
        "start": "pnpm check-node-version && run-s admin-generator intl:compile && run-p gql:types generate-block-types && dotenv -e .env.secrets -e .env.local -e .env -e .env.site-configs -- vite"
    },
    "dependencies": {
        "@apollo/client": "^3.14.1",
        "@dextinity/admin": "workspace:*",
        "@dextinity/admin-icons": "workspace:*",
        "@dextinity/brevo-admin": "workspace:*",
        "@dextinity/cms-admin": "workspace:*",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource-variable/roboto-flex": "^5.3.0",
        "@mui/material": "^7.3.11",
        "@mui/system": "^7.3.11",
        "@mui/x-data-grid": "^8.29.3",
        "@mui/x-data-grid-pro": "^8.29.3",
        "@mui/x-date-pickers": "^8.29.4",
        "@mui/x-license": "^8.29.3",
        "change-case": "^5.4.4",
        "date-fns": "^4.4.0",
        "dnd-core": "^16.0.1",
        "fast-equals": "^5.4.0",
        "final-form": "^4.20.10",
        "graphql": "^16.14.2",
        "p-debounce": "^6.0.0",
        "rdndmb-html5-to-touch": "^9.0.0",
        "react": "^19.3.0",
        "react-dnd": "^16.0.1",
        "react-dnd-multi-backend": "^9.0.0",
        "react-dom": "^19.3.0",
        "react-final-form": "^6.5.9",
        "react-intl": "^12.1.4",
        "react-router": "^5.3.4",
        "react-router-dom": "^5.3.4",
        "use-debounce": "^10.1.1",
        "uuid": "^14.0.3"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@dextinity/admin-generator": "workspace:*",
        "@dextinity/cli": "workspace:*",
        "@dextinity/oxlint-config": "workspace:*",
        "@formatjs/cli": "^6.16.34",
        "@graphql-codegen/add": "^7.1.1",
        "@graphql-codegen/cli": "^7.4.6",
        "@graphql-codegen/fragment-matcher": "^7.1.0",
        "@graphql-codegen/introspection": "^6.1.0",
        "@graphql-codegen/named-operations-object": "^4.0.1",
        "@graphql-codegen/near-operation-file-preset": "^5.2.3",
        "@graphql-codegen/typescript": "^6.1.2",
        "@graphql-codegen/typescript-operations": "^6.1.10",
        "@parcel/watcher": "^2.6.0",
        "@swc/plugin-emotion": "^17.0.0",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-router": "^5.1.20",
        "@types/react-router-dom": "^5.3.3",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "check-node-version": "^4.2.1",
        "chokidar-cli": "^3.0.0",
        "cosmiconfig-toml-loader": "^1.0.0",
        "dotenv-cli": "^11.0.0",
        "npm-run-all2": "^9.0.3",
        "oxlint": "1.89.0",
        "oxlint-tsgolint": "7.0.2004",
        "prettier": "^3.9.10",
        "rimraf": "^6.1.3",
        "typescript": "^6.0.3",
        "vite": "^7.3.7",
        "vite-plugin-compression2": "^2.5.3",
        "vite-plugin-html": "^3.2.2"
    }
}
