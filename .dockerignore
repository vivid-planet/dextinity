# Build context of the deploy preview environment (see .deploy-preview/docker-compose.yml).
# Everything that install and build generate is excluded, so that a build from a fresh clone and a
# build from a local working copy produce the same image.

.git
**/node_modules
**/.env.local
**/.env.secrets
**/.env.site-configs
**/.env.site-configs.deploy-preview
demo/*/.env

# Generated by copy-project-files.js, which runs in the Dockerfiles
packages/admin/cms-admin/block-meta.json
packages/admin/cms-admin/schema.gql
packages/admin/brevo-admin/block-meta.json
packages/admin/brevo-admin/schema.gql
packages/site/site-nextjs/block-meta.json
packages/site/site-react/block-meta.json
packages/mail-react/block-meta.json
demo/admin/block-meta.json
demo/admin/schema.gql
demo/site/block-meta.json
demo/site/schema.gql
demo/*/src/dextinity-config.json
demo/*/src/site-configs.d.ts
!demo/api/src/dextinity-config.json

# Build output
**/lib
**/dist
**/build
**/.next
**/.turbo
**/coverage
**/storybook-static
**/*.tsbuildinfo
demo/uploads

# Downloaded at build time by intl-update.sh
**/lang
**/lang-compiled
**/lang-extracted

# Not needed by the demo, excluded so that editing them does not invalidate the build cache
docs
storybook
!docs/package.json
!storybook/package.json
**/*.md
