{
    "name": "dextinity-demo-site",
    "private": true,
    "description": "Dextinity Site Demo Application",
    "type": "module",
    "scripts": {
        "build": "run-s intl:compile && run-p gql:types generate-block-types css:types && next build --webpack",
        "build-storybook": "storybook build --disable-telemetry",
        "check-node-version": "check-node-version --node $(cat ../../.nvmrc)",
        "css:types": "typed-scss-modules src --nameFormat none --exportType default --aliasPrefixes.@src src",
        "css:types:watch": "pnpm run css:types --watch",
        "dev": "pnpm check-node-version && run-s intl:compile && run-p gql:types generate-block-types css:types && dotenv -e .env.secrets -e .env.local -e .env -e .env.site-configs -- node --inspect=localhost:9230 --max-old-space-size=768 server.ts",
        "export": "next export",
        "generate-block-types": "dextinity generate-block-types",
        "generate-block-types:watch": "chokidar -s \"block-meta.json\" -c \"pnpm generate-block-types\"",
        "gql:types": "graphql-codegen",
        "gql:watch": "graphql-codegen --watch",
        "intl:compile": "formatjs compile-folder --format simple --ast lang/dextinity-demo-lang/site lang-compiled/",
        "intl:extract": "formatjs extract \"src/**/*.{ts,tsx}\" --ignore '**/*.{test,spec}.{ts,tsx}' --ignore **/*.d.ts --out-file lang-extracted/en.json --format simple",
        "lint": "run-s intl:compile && run-p gql:types generate-block-types css:types && run-p lint:prettier lint:eslint lint:tsc lint:style",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ .storybook/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier lint:fix:style",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:fix:style": "pnpm run lint:style --fix",
        "lint:prettier": "pnpm exec prettier --check '*.{ts,js,json,md,yml,yaml,css,scss}'",
        "lint:style": "pnpm exec stylelint '**/*.{css,scss}'",
        "lint:tsc": "pnpm exec next typegen && run-s lint:tsc:app lint:tsc:server lint:tsc:storybook",
        "lint:tsc:app": "tsc --project .",
        "lint:tsc:server": "tsc --project tsconfig.server.json",
        "lint:tsc:storybook": "tsc --project tsconfig.storybook.json",
        "serve": "NODE_ENV=production node server.ts",
        "storybook": "storybook dev -p 26648 --no-open --disable-telemetry",
        "test": "pnpm run test:unit && pnpm run test:storybook",
        "test:storybook": "vitest --run --project storybook --outputFile.junit=./junit-storybook.xml",
        "test:unit": "vitest --run --project unit --outputFile.junit=./junit-unit.xml",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1164.0",
        "@base-ui/react": "^1.9.0",
        "@dextinity/mail-react": "workspace:*",
        "@dextinity/site-nextjs": "workspace:*",
        "@formatjs/cli": "^6.18.2",
        "@google-cloud/recaptcha-enterprise": "^7.3.0",
        "@next/bundle-analyzer": "^16.4.6",
        "@opentelemetry/api": "^1.10.0",
        "@opentelemetry/auto-instrumentations-node": "^0.83.0",
        "@opentelemetry/exporter-prometheus": "^0.301.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
        "@opentelemetry/instrumentation-runtime-node": "^0.38.0",
        "@opentelemetry/sdk-node": "^0.301.0",
        "cache-manager": "^7.2.9",
        "clsx": "^2.1.1",
        "embla-carousel": "9.0.0-rc04",
        "embla-carousel-accessibility": "9.0.0-rc04",
        "embla-carousel-auto-height": "9.0.0-rc04",
        "embla-carousel-react": "9.0.0-rc04",
        "filesize": "^11.0.30",
        "ioredis": "^6.0.0",
        "lru-cache": "^11.5.3",
        "mjml": "^4.18.0",
        "next": "^16.4.6",
        "nodemailer": "^10.5.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-focus-lock": "^2.13.7",
        "react-hook-form": "^7.91.0",
        "react-intl": "^7.1.14",
        "redraft": "^0.10.2",
        "usehooks-ts": "^3.1.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@babel/core": "^7.29.13",
        "@dextinity/cli": "workspace:*",
        "@dextinity/eslint-config": "workspace:*",
        "@graphql-codegen/add": "^5.0.3",
        "@graphql-codegen/cli": "^5.0.7",
        "@graphql-codegen/named-operations-object": "^3.1.1",
        "@graphql-codegen/near-operation-file-preset": "^3.1.0",
        "@graphql-codegen/typescript": "^4.1.6",
        "@graphql-codegen/typescript-operations": "^4.6.1",
        "@parcel/watcher": "^2.6.0",
        "@storybook/addon-a11y": "10.6.7",
        "@storybook/addon-docs": "^10.6.7",
        "@storybook/addon-vitest": "10.6.7",
        "@storybook/nextjs-vite": "10.6.7",
        "@types/grecaptcha": "^3.0.9",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitest/browser-playwright": "5.1.0",
        "check-node-version": "^4.2.1",
        "chokidar-cli": "^3.0.0",
        "eslint": "^9.39.5",
        "eslint-plugin-storybook": "^10.6.7",
        "graphql": "^16.15.0",
        "jsdom": "^28.1.0",
        "npm-run-all2": "^9.0.4",
        "playwright": "^1.65.0",
        "prettier": "^3.9.10",
        "sass": "^1.108.1",
        "schema-dts": "^2.1.0",
        "storybook": "^10.6.7",
        "stylelint": "^18.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typed-scss-modules": "^8.1.1",
        "typescript": "^5.9.3",
        "vitest": "^5.1.0"
    },
    "engines": {
        "node": "24"
    }
}
