{
    "name": "@dextinity/brevo-api",
    "version": "10.1.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity",
        "directory": "packages/api/brevo-api"
    },
    "license": "BSD-2-Clause",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "sideEffects": false,
    "files": [
        "lib/*"
    ],
    "scripts": {
        "build": "$npm_execpath run clean && tsc -p tsconfig.build.json",
        "clean": "rimraf lib",
        "dev": "tsc --watch --preserveWatchOutput -p tsconfig.build.json",
        "generate-block-meta": "ts-node generate-block-meta.ts",
        "generate-block-meta:watch": "chokidar \"src/\" -c \"$npm_execpath generate-block-meta\"",
        "generate-schema": "ts-node generate-schema.ts",
        "generate-schema:watch": "chokidar \"src/\" -c \"$npm_execpath generate-schema\"",
        "lint": "run-p lint:prettier lint:eslint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:prettier": "npx prettier --check './**/*.{js,json,md,yml,yaml}'",
        "lint:tsc": "tsc --noEmit",
        "mikro-orm": "dotenv -e .env.secrets -e .env.local -e .env -e .env.site-configs -- mikro-orm",
        "test": "pnpm run test:unit",
        "test:unit": "vitest --run --passWithNoTests",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "@dextinity/cms-api": "workspace:*",
        "@fast-csv/parse": "^5.0.7",
        "@getbrevo/brevo": "^5.0.4",
        "@nestjs/axios": "^4.0.1",
        "@nestjs/cache-manager": "^3.1.2",
        "@nestjs/jwt": "^11.0.2",
        "axios": "^1.16.1",
        "cache-manager": "^7.2.5",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "commander": "^14.0.3",
        "graphql-scalars": "1.25.0",
        "lodash.isequal": "^4.5.0",
        "nest-commander": "^3.20.1",
        "uuid": "^11.1.1"
    },
    "devDependencies": {
        "@dextinity/eslint-config": "workspace:*",
        "@kubernetes/client-node": "^1.4.0",
        "@mikro-orm/cli": "^6.6.14",
        "@mikro-orm/core": "^6.6.14",
        "@mikro-orm/migrations": "^6.6.14",
        "@mikro-orm/nestjs": "^6.1.2",
        "@mikro-orm/postgresql": "^6.6.14",
        "@nestjs/common": "^11.1.21",
        "@nestjs/core": "^11.1.21",
        "@nestjs/graphql": "^13.4.0",
        "@nestjs/platform-express": "^11.1.21",
        "@nestjs/testing": "^11.1.21",
        "@swc/core": "^1.15.40",
        "@types/inquirer": "^8.2.12",
        "@types/lodash.isequal": "^4.5.8",
        "chokidar-cli": "^2.1.0",
        "eslint": "^9.39.4",
        "express": "^5.2.1",
        "graphql": "^16.14.2",
        "prettier": "^3.4.2",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^3.0.2",
        "rxjs": "^7.8.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "unplugin-swc": "^1.5.9",
        "vitest": "^4.1.8"
    },
    "peerDependencies": {
        "@mikro-orm/cli": "^6.0.0",
        "@mikro-orm/core": "^6.0.0",
        "@mikro-orm/migrations": "^6.0.0",
        "@mikro-orm/nestjs": "^6.0.0",
        "@mikro-orm/postgresql": "^6.0.0",
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/graphql": "^13.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "graphql": "^16.6.0",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.0.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    }
}
