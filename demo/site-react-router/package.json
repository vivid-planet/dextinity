{
    "name": "dextinity-demo-site-react-router",
    "private": true,
    "description": "Dextinity Site Demo Application with React Router and React Server Components",
    "type": "module",
    "scripts": {
        "build": "run-s intl:compile && run-p gql:types generate-block-types css:types && react-router build",
        "check-node-version": "check-node-version --node $(cat ../../.nvmrc)",
        "css:types": "typed-scss-modules src --nameFormat none --exportType default --aliasPrefixes.@src src",
        "css:types:watch": "pnpm run css:types --watch",
        "dev": "pnpm check-node-version && run-s intl:compile site-configs && run-p gql:types generate-block-types css:types typegen && dotenv -e .env.react-router -e .env.secrets -e .env.local -e .env -e .env.site-configs -- node --inspect=localhost:9231 --max-old-space-size=768 server.ts",
        "generate-block-types": "dextinity generate-block-types",
        "generate-block-types:watch": "chokidar -s \"block-meta.json\" -c \"pnpm generate-block-types\"",
        "gql:types": "graphql-codegen",
        "gql:watch": "graphql-codegen --watch",
        "intl:compile": "formatjs compile-folder --format simple --ast ../site/lang/dextinity-demo-lang/site lang-compiled/",
        "intl:extract": "formatjs extract \"src/**/*.{ts,tsx}\" --ignore '**/*.{test,spec}.{ts,tsx}' --ignore **/*.d.ts --out-file lang-extracted/en.json --format simple",
        "lint": "run-s intl:compile && run-p gql:types generate-block-types css:types typegen && run-p lint:prettier lint:eslint lint:tsc lint:style",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier lint:fix:style",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:fix:style": "pnpm run lint:style --fix",
        "lint:prettier": "pnpm exec prettier --check '*.{ts,js,json,md,yml,yaml,css,scss}'",
        "lint:style": "pnpm exec stylelint '**/*.{css,scss}'",
        "lint:tsc": "tsc --project . && tsc --project tsconfig.server.json",
        "serve": "NODE_ENV=production dotenv -e .env.react-router -e .env.secrets -e .env.local -e .env -e .env.site-configs -- node server.ts",
        "site-configs": "dotenv -e .env.react-router -e .env.secrets -e .env.local -e .env -- dextinity inject-site-configs -f ../site-configs/site-configs.ts -i ../.env.site-configs.tpl -o .env.site-configs --base64",
        "test": "pnpm run test:unit",
        "test:unit": "vitest --run",
        "test:watch": "vitest --watch",
        "typegen": "react-router typegen"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@dextinity/mail-react": "workspace:*",
        "@dextinity/site-react-router": "workspace:*",
        "@fontsource-variable/inter": "^5.3.0",
        "@formatjs/cli": "^6.18.0",
        "@google-cloud/recaptcha-enterprise": "^7.3.0",
        "@opentelemetry/api": "^1.10.0",
        "@opentelemetry/auto-instrumentations-node": "^0.82.0",
        "@opentelemetry/exporter-prometheus": "^0.300.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
        "@opentelemetry/instrumentation-runtime-node": "^0.37.0",
        "@opentelemetry/sdk-node": "^0.300.0",
        "@remix-run/node-fetch-server": "^0.14.1",
        "cache-manager": "^7.2.9",
        "clsx": "^2.1.1",
        "csso": "^5.0.5",
        "embla-carousel": "9.0.0-rc04",
        "embla-carousel-accessibility": "9.0.0-rc04",
        "embla-carousel-auto-height": "9.0.0-rc04",
        "embla-carousel-react": "9.0.0-rc04",
        "filesize": "^11.0.29",
        "ioredis": "^6.0.0",
        "mjml": "^4.18.0",
        "nodemailer": "^10.3.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-focus-lock": "^2.13.7",
        "react-hook-form": "^7.91.0",
        "react-intl": "^7.1.14",
        "react-router": "8.5.1",
        "redraft": "^0.10.2",
        "usehooks-ts": "^3.1.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@dextinity/cli": "workspace:*",
        "@dextinity/eslint-config": "workspace:*",
        "@graphql-codegen/add": "^5.0.3",
        "@graphql-codegen/cli": "^5.0.7",
        "@graphql-codegen/named-operations-object": "^3.1.1",
        "@graphql-codegen/near-operation-file-preset": "^3.1.0",
        "@graphql-codegen/typescript": "^4.1.6",
        "@graphql-codegen/typescript-operations": "^4.6.1",
        "@parcel/watcher": "^2.6.0",
        "@react-router/dev": "8.5.1",
        "@types/grecaptcha": "^3.0.9",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-rsc": "0.5.35",
        "check-node-version": "^4.2.1",
        "chokidar-cli": "^3.0.0",
        "dotenv-cli": "^11.1.0",
        "eslint": "^9.39.5",
        "graphql": "^16.14.2",
        "jsdom": "^28.1.0",
        "npm-run-all2": "^9.0.4",
        "prettier": "^3.9.10",
        "react-server-dom-webpack": "19.3.1",
        "sass": "^1.107.1",
        "schema-dts": "^2.1.0",
        "stylelint": "^17.16.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typed-scss-modules": "^8.1.1",
        "typescript": "^5.9.3",
        "vite": "^8.3.5",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": "24"
    }
}
