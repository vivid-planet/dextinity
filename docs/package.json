{
    "name": "dextinity-docs",
    "private": true,
    "description": "Documentation for Dextinity",
    "scripts": {
        "build": "docusaurus build",
        "clear": "docusaurus clear",
        "deploy": "docusaurus deploy",
        "docusaurus": "docusaurus",
        "lint": "run-p lint:prettier lint:eslint",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:prettier": "pnpm exec prettier --check '*.{ts,js,json,md,yml,yaml}'",
        "serve": "docusaurus serve",
        "start": "docusaurus start --port 3300",
        "swizzle": "docusaurus swizzle",
        "write-heading-ids": "docusaurus write-heading-ids",
        "write-translations": "docusaurus write-translations"
    },
    "browserslist": {
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ],
        "production": [
            ">0.5%",
            "not dead",
            "not op_mini all"
        ]
    },
    "dependencies": {
        "@algolia/client-search": "^5.59.0",
        "@docusaurus/core": "^3.10.2",
        "@docusaurus/preset-classic": "^3.10.2",
        "@docusaurus/theme-mermaid": "^3.10.2",
        "@mdx-js/react": "^3.1.1",
        "prism-react-renderer": "^2.4.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "search-insights": "^2.17.3"
    },
    "devDependencies": {
        "@dextinity/eslint-config": "workspace:*",
        "@docusaurus/module-type-aliases": "^3.10.2",
        "@docusaurus/plugin-content-docs": "^3.10.2",
        "@docusaurus/tsconfig": "^3.10.2",
        "@docusaurus/types": "^3.10.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.39.5",
        "npm-run-all2": "^9.0.3",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": ">=18.0"
    }
}
