{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true,
        "module": "preserve",
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ESNext",
        "types": ["node"],
        "verbatimModuleSyntax": true
    },
    "include": ["server.ts", "tracing.production.ts", "tracing.dev.ts", "cache-handler.ts", "opentelemetry-metrics.ts"]
}
