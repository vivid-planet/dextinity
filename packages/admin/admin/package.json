{
    "name": "@dextinity/admin",
    "version": "10.1.0",
    "description": "Dextinity Admin package",
    "repository": {
        "directory": "packages/admin/admin",
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity"
    },
    "license": "BSD-2-Clause",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "import": "./lib/index.js",
            "types": "./lib/index.d.ts"
        }
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "build": "pnpm run clean && run-p build:babel build:types",
        "build-storybook": "storybook build --disable-telemetry",
        "build:babel": "pnpm exec babel ./src -x \".ts,.tsx\" -d lib --config-file ./.babelrc.build.json",
        "build:types": "tsc --project ./tsconfig.build.json --emitDeclarationOnly",
        "clean": "rimraf lib",
        "lint": "run-p lint:prettier lint:eslint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:prettier": "pnpm exec prettier --check '*.{ts,js,json,md,yml,yaml}'",
        "lint:tsc": "tsc --noEmit",
        "start": "run-p start:babel start:types",
        "start:babel": "pnpm exec babel ./src -x \".ts,.tsx\" -d lib -w --config-file ./.babelrc.build.json",
        "start:types": "tsc --project ./tsconfig.json --emitDeclarationOnly --watch --preserveWatchOutput",
        "storybook": "storybook dev -p 26646 --no-open --disable-telemetry",
        "test": "pnpm run test:unit && pnpm run test:storybook",
        "test:storybook": "vitest --run --project storybook --outputFile.junit=./junit-storybook.xml",
        "test:unit": "vitest --run --project unit --outputFile.junit=./junit-unit.xml",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "@dextinity/admin-icons": "workspace:*",
        "@mui/utils": "^7.3.11",
        "date-fns": "^4.4.0",
        "exceljs": "^4.4.0",
        "final-form-set-field-data": "^1.0.2",
        "http-status-codes": "^2.3.0",
        "is-mobile": "^4.0.0",
        "lodash.debounce": "^4.0.8",
        "lodash.isequal": "^4.5.0",
        "query-string": "^7.1.3",
        "react-dropzone": "^14.3.8",
        "use-constant": "^2.0.0",
        "uuid": "^11.1.1"
    },
    "devDependencies": {
        "@apollo/client": "^3.14.1",
        "@babel/cli": "^7.29.7",
        "@babel/core": "^7.29.7",
        "@dextinity/admin-babel-preset": "workspace:*",
        "@dextinity/eslint-config": "workspace:*",
        "@dextinity/eslint-plugin": "workspace:*",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/material": "^7.3.11",
        "@mui/system": "^7.3.11",
        "@mui/x-data-grid": "^8.28.7",
        "@mui/x-data-grid-premium": "^8.28.7",
        "@mui/x-data-grid-pro": "^8.28.7",
        "@mui/x-date-pickers": "^8.28.7",
        "@mui/x-date-pickers-pro": "^8.28.7",
        "@storybook/addon-docs": "^10.3.5",
        "@storybook/addon-vitest": "10.3.5",
        "@storybook/react-vite": "^10.3.5",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/final-form-set-field-data": "^1.0.3",
        "@types/history": "^4.7.11",
        "@types/lodash.debounce": "^4.0.9",
        "@types/lodash.isequal": "^4.5.8",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "@types/react-router": "^5.1.20",
        "@types/react-router-dom": "^5.3.3",
        "@vitest/browser": "4.1.8",
        "@vitest/browser-playwright": "4.1.8",
        "eslint": "^9.39.4",
        "eslint-plugin-storybook": "^10.3.5",
        "final-form": "^4.20.10",
        "graphql": "^16.14.2",
        "history": "^4.10.1",
        "jsdom": "^28.1.0",
        "msw": "^2.10.4",
        "npm-run-all2": "^8.0.4",
        "playwright": "^1.62.0",
        "prettier": "^3.6.2",
        "react": "^19.2.6",
        "react-dnd": "^16.0.1",
        "react-dom": "^19.2.6",
        "react-final-form": "^6.5.9",
        "react-intl": "^7.1.11",
        "react-router": "^5.3.4",
        "react-router-dom": "^5.3.4",
        "rimraf": "^6.1.2",
        "storybook": "^10.3.5",
        "storybook-addon-tag-badges": "^3.1.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vite-tsconfig-paths": "^6.0.4",
        "vitest": "^4.1.8"
    },
    "peerDependencies": {
        "@apollo/client": "^3.7.0",
        "@emotion/react": "^11.5.0",
        "@emotion/styled": "^11.3.0",
        "@mui/material": "^7.0.0",
        "@mui/x-data-grid": "^8.0.0",
        "@mui/x-data-grid-premium": "^8.0.0",
        "@mui/x-data-grid-pro": "^8.0.0",
        "@mui/x-date-pickers": "^8.0.0",
        "@mui/x-date-pickers-pro": "^8.0.0",
        "final-form": "^4.16.1",
        "graphql": "^14.0.0 || ^15.0.0 || ^16.0.0",
        "history": "^4.10.1",
        "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
        "react-dnd": "^16.0.0",
        "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0",
        "react-final-form": "^6.3.1",
        "react-intl": "^5.0.0 || ^6.0.0 || ^7.0.0",
        "react-router": "^5.1.2",
        "react-router-dom": "^5.1.2"
    },
    "peerDependenciesMeta": {
        "@mui/x-data-grid-premium": {
            "optional": true
        },
        "@mui/x-data-grid-pro": {
            "optional": true
        },
        "@mui/x-date-pickers-pro": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    }
}
