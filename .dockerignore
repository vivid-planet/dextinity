# Build context of the deploy preview, see .deploy-preview/. Everything install and build generate
# is excluded, so that a local working copy builds the same images as a fresh clone.

.git
**/node_modules
**/.env.local
**/.env.secrets
**/.env.site-configs
**/.env.site-configs.deploy-preview
demo/*/.env

# Generated by copy-project-files.js
packages/admin/cms-admin/block-meta.json
packages/admin/cms-admin/schema.gql
packages/admin/brevo-admin/block-meta.json
packages/admin/brevo-admin/schema.gql
packages/site/site-nextjs/block-meta.json
packages/site/site-react/block-meta.json
packages/mail-react/block-meta.json
demo/admin/block-meta.json
demo/admin/schema.gql
demo/site/block-meta.json
demo/site/schema.gql
demo/*/src/dextinity-config.json
demo/*/src/site-configs.d.ts
!demo/api/src/dextinity-config.json

**/lib
**/dist
**/build
**/.next
**/.turbo
**/coverage
**/storybook-static
**/*.tsbuildinfo
demo/uploads

# Cloned by intl-update.sh
**/lang
**/lang-compiled
**/lang-extracted

# Not needed by the demo
docs
storybook
!docs/package.json
!storybook/package.json
**/*.md
