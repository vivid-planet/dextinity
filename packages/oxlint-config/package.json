{
    "name": "@dextinity/oxlint-config",
    "version": "10.10.0",
    "description": "A set of oxlint configurations for Dextinity projects",
    "repository": {
        "directory": "packages/oxlint-config",
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity"
    },
    "license": "BSD-2-Clause",
    "type": "module",
    "exports": {
        "./core.js": {
            "types": "./lib/core.d.ts",
            "import": "./lib/core.js"
        },
        "./nestjs.js": {
            "types": "./lib/nestjs.d.ts",
            "import": "./lib/nestjs.js"
        },
        "./nextjs.js": {
            "types": "./lib/nextjs.d.ts",
            "import": "./lib/nextjs.js"
        },
        "./react.js": {
            "types": "./lib/react.d.ts",
            "import": "./lib/react.js"
        }
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "build": "pnpm run clean && tsc",
        "clean": "rimraf lib",
        "dev": "tsc --watch",
        "lint": "run-p lint:prettier lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:fix": "pnpm run lint:prettier --write",
        "lint:prettier": "pnpm exec prettier --check '*.{ts,js,json,md,yml,yaml}' 'src/**/*.ts'",
        "lint:tsc": "tsc --noEmit"
    },
    "dependencies": {
        "@dextinity/eslint-plugin": "workspace:*",
        "eslint": "^9.39.5",
        "eslint-plugin-formatjs": "^8.0.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-simple-import-sort": "^12.1.1"
    },
    "devDependencies": {
        "npm-run-all2": "^9.0.3",
        "oxlint": "1.89.0",
        "oxlint-tsgolint": "7.0.2004",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "oxlint": "1.89.0",
        "oxlint-tsgolint": "7.0.2004"
    },
    "engines": {
        "node": ">=24.15.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    }
}
