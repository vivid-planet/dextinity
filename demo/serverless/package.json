{
    "name": "dextinity-demo-serverless",
    "private": true,
    "description": "Prototype: Dextinity Demo on Cloudflare Workers (admin in src/, API in api/, one Worker, D1 or PostgreSQL)",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:postgresql": "CLOUDFLARE_ENV=postgresql vite build",
        "db:generate": "drizzle-kit generate --config drizzle.config.d1.ts && drizzle-kit generate --config drizzle.config.postgresql.ts",
        "db:migrate:d1": "wrangler d1 migrations apply DB --local",
        "db:migrate:postgresql": "dotenv -e ../../.env.local -e ../../.env -- node scripts/database.ts postgresql migrate",
        "db:seed:d1": "pnpm run db:migrate:d1 && node scripts/database.ts sqlite seed",
        "db:seed:postgresql": "dotenv -e ../../.env.local -e ../../.env -- node scripts/database.ts postgresql seed",
        "deploy": "vite build && wrangler deploy",
        "dev": "dotenv -e ../../.env.local -e ../../.env -- ./scripts/dev.sh",
        "dev:postgresql": "dotenv -e ../../.env.local -e ../../.env -- ./scripts/dev.sh postgresql",
        "lint": "run-p lint:prettier lint:eslint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ api/ shared/ scripts/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:prettier": "pnpm exec prettier --check '*.{ts,mts,js,json,jsonc,md,yml,yaml}'",
        "lint:tsc": "tsc -b",
        "smoke-test": "dotenv -e ../../.env.local -e ../../.env -- node scripts/smoke-test.ts"
    },
    "dependencies": {
        "@apollo/client": "^3.14.1",
        "@dextinity/admin": "workspace:*",
        "@dextinity/admin-icons": "workspace:*",
        "@dextinity/cms-admin": "workspace:*",
        "@dextinity/serverless-blocks": "workspace:*",
        "@dextinity/serverless-core": "workspace:*",
        "@dextinity/serverless-dam": "workspace:*",
        "@dextinity/serverless-page-tree": "workspace:*",
        "@dextinity/serverless-permissions": "workspace:*",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource-variable/roboto-flex": "^5.3.0",
        "@mui/material": "^7.3.11",
        "@mui/x-data-grid": "^8.29.5",
        "@mui/x-date-pickers": "^8.29.5",
        "@tanstack/react-query": "^5.104.5",
        "drizzle-orm": "^0.45.4",
        "final-form": "^4.20.10",
        "graphql": "^16.14.2",
        "history": "^4.10.1",
        "hono": "^4.13.13",
        "postgres": "^3.4.9",
        "react": "^19.3.0",
        "react-dnd": "^16.0.1",
        "react-dnd-html5-backend": "^16.0.1",
        "react-dom": "^19.3.0",
        "react-final-form": "^6.5.9",
        "react-intl": "^7.1.14",
        "react-router": "^5.3.4",
        "react-router-dom": "^5.3.4",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "1.65.0",
        "@cloudflare/workers-types": "^5.20261023.1",
        "@dextinity/eslint-config": "workspace:*",
        "@swc/plugin-emotion": "^19.0.0",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-router": "^5.1.20",
        "@types/react-router-dom": "^5.3.3",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "dotenv-cli": "^11.0.0",
        "drizzle-kit": "^0.31.11",
        "eslint": "^9.39.5",
        "npm-run-all2": "^9.0.3",
        "prettier": "^3.9.10",
        "sharp": "^0.35.5",
        "typescript": "5.9.3",
        "vite": "^8.3.5",
        "wrangler": "^4.152.0"
    }
}
