{
    "name": "@dextinity/serverless",
    "version": "10.10.0",
    "private": true,
    "description": "Prototype: Dextinity for Hono on Cloudflare Workers and the admin: core, permissions, blocks, DAM and page tree",
    "repository": {
        "directory": "packages/serverless",
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity"
    },
    "license": "BSD-2-Clause",
    "sideEffects": false,
    "type": "module",
    "exports": {
        "./client": {
            "types": "./lib/client.d.ts",
            "import": "./lib/client.js",
            "default": "./lib/client.js"
        },
        "./server": {
            "types": "./lib/server.d.ts",
            "import": "./lib/server.js",
            "default": "./lib/server.js"
        },
        "./vite": {
            "types": "./lib/vite.d.ts",
            "import": "./lib/vite.js",
            "default": "./lib/vite.js"
        }
    },
    "files": [
        "lib/*",
        "!lib/*.tsbuildinfo"
    ],
    "scripts": {
        "build": "pnpm run clean && tsc -p tsconfig.build.json",
        "clean": "rimraf lib",
        "dev": "tsc --watch --preserveWatchOutput -p tsconfig.build.json",
        "lint": "run-p lint:prettier lint:eslint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:prettier": "pnpm exec prettier --check '*.{ts,js,json,md,yml,yaml}'",
        "lint:tsc": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@dextinity/admin-icons": "workspace:*",
        "@hapi/accept": "^6.0.3",
        "@hono/zod-validator": "^0.9.1",
        "exifr": "^7.1.3",
        "jose": "^6.2.12",
        "jszip": "^3.10.2",
        "mime-db": "^1.54.0",
        "slugify": "^1.6.9"
    },
    "devDependencies": {
        "@apollo/client": "^3.14.1",
        "@dextinity/admin": "workspace:*",
        "@dextinity/cms-admin": "workspace:*",
        "@dextinity/eslint-config": "workspace:*",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/material": "^7.3.11",
        "@mui/x-data-grid": "^8.29.5",
        "@tanstack/react-query": "^5.104.5",
        "@types/mime-db": "^1.43.6",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-router": "^5.1.20",
        "drizzle-orm": "^0.45.4",
        "eslint": "^9.39.5",
        "final-form": "^4.20.10",
        "graphql": "^16.14.2",
        "hono": "^4.13.13",
        "npm-run-all2": "^9.0.3",
        "prettier": "^3.9.10",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-final-form": "^6.5.9",
        "react-intl": "^7.1.14",
        "react-router": "^5.3.4",
        "rimraf": "^6.1.3",
        "sharp": "^0.35.5",
        "typescript": "5.9.3",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "@apollo/client": "^3.7.0",
        "@dextinity/admin": "workspace:*",
        "@dextinity/cms-admin": "workspace:*",
        "@mui/material": "^7.0.0",
        "@mui/x-data-grid": "^8.0.0",
        "@tanstack/react-query": "^5.0.0",
        "drizzle-orm": "^0.45.0",
        "hono": "^4.13.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-final-form": "^6.3.1",
        "react-intl": "^7.0.0",
        "react-router": "^5.0.0",
        "sharp": "^0.35.0",
        "vite": "^8.0.0",
        "zod": "^4.0.0"
    },
    "peerDependenciesMeta": {
        "@apollo/client": {
            "optional": true
        },
        "@dextinity/admin": {
            "optional": true
        },
        "@dextinity/cms-admin": {
            "optional": true
        },
        "@mui/material": {
            "optional": true
        },
        "@mui/x-data-grid": {
            "optional": true
        },
        "@tanstack/react-query": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        },
        "react-final-form": {
            "optional": true
        },
        "react-intl": {
            "optional": true
        },
        "react-router": {
            "optional": true
        },
        "sharp": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    }
}
