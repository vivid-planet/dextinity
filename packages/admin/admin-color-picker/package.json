{
    "name": "@dextinity/admin-color-picker",
    "version": "10.1.0",
    "description": "Dextinity Admin Color Picker component",
    "repository": {
        "directory": "packages/admin/admin-color-picker",
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity"
    },
    "license": "BSD-2-Clause",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "import": "./lib/index.js",
            "types": "./lib/index.d.ts"
        }
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "build": "pnpm run clean && run-p build:babel build:types",
        "build:babel": "pnpm exec babel ./src -x \".ts,.tsx\" -d lib",
        "build:types": "tsc --project ./tsconfig.json --emitDeclarationOnly",
        "clean": "rimraf lib",
        "lint": "run-p lint:prettier lint:eslint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:prettier": "pnpm exec prettier --check '*.{ts,js,json,md,yml,yaml}'",
        "lint:tsc": "tsc --noEmit",
        "start": "run-p start:babel start:types",
        "start:babel": "pnpm exec babel ./src -x \".ts,.tsx\" -d lib -w",
        "start:types": "tsc --project ./tsconfig.json --emitDeclarationOnly --watch --preserveWatchOutput"
    },
    "dependencies": {
        "@dextinity/admin": "workspace:*",
        "@dextinity/admin-icons": "workspace:*",
        "react-colorful": "^5.6.1",
        "tinycolor2": "^1.6.0",
        "use-debounce": "^10.0.6"
    },
    "devDependencies": {
        "@babel/cli": "^7.29.7",
        "@babel/core": "^7.29.7",
        "@dextinity/admin-babel-preset": "workspace:*",
        "@dextinity/eslint-config": "workspace:*",
        "@mui/material": "^7.3.11",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "@types/tinycolor2": "^1.4.6",
        "eslint": "^9.39.4",
        "final-form": "^4.20.10",
        "npm-run-all2": "^8.0.4",
        "prettier": "^3.6.2",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-final-form": "^6.5.9",
        "react-intl": "^7.1.11",
        "rimraf": "^6.1.2",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "@mui/material": "^7.0.0",
        "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
        "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0",
        "react-final-form": "^6.3.1",
        "react-intl": "^5.0.0 || ^6.0.0 || ^7.0.0"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    }
}
