{
    "name": "@dextinity/brevo-api",
    "version": "10.10.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity",
        "directory": "packages/api/brevo-api"
    },
    "license": "BSD-2-Clause",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "lib/*",
        "!lib/*.tsbuildinfo"
    ],
    "scripts": {
        "build": "$npm_execpath run clean && tsc -p tsconfig.build.json",
        "clean": "rimraf lib",
        "dev": "tsc --watch --preserveWatchOutput -p tsconfig.build.json",
        "generate-block-meta": "node -r @swc-node/register generate-block-meta.ts",
        "generate-block-meta:watch": "chokidar \"lib/\" -c \"$npm_execpath generate-block-meta\"",
        "generate-schema": "node -r @swc-node/register generate-schema.ts",
        "generate-schema:watch": "chokidar \"lib/\" -c \"$npm_execpath generate-schema\"",
        "lint": "run-p lint:prettier lint:eslint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:prettier": "npx prettier --check './**/*.{js,json,md,yml,yaml}'",
        "lint:tsc": "tsc --noEmit",
        "mikro-orm": "dotenv -e .env.secrets -e .env.local -e .env -e .env.site-configs -- mikro-orm",
        "test": "pnpm run test:unit",
        "test:unit": "vitest --run --passWithNoTests",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "@dextinity/cms-api": "workspace:*",
        "@fast-csv/parse": "^5.0.8",
        "@getbrevo/brevo": "^6.2.0",
        "@nestjs/cache-manager": "^12.0.0",
        "@nestjs/jwt": "^12.0.2",
        "cache-manager": "^7.2.9",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "commander": "^15.0.0",
        "nest-commander": "^3.21.0"
    },
    "devDependencies": {
        "@dextinity/eslint-config": "workspace:*",
        "@kubernetes/client-node": "^1.4.0",
        "@mikro-orm/cli": "^7.2.0",
        "@mikro-orm/core": "^7.2.0",
        "@mikro-orm/decorators": "^7.2.0",
        "@mikro-orm/migrations": "^7.2.0",
        "@mikro-orm/nestjs": "^7.1.0",
        "@mikro-orm/postgresql": "^7.2.0",
        "@nestjs/common": "^12.0.4",
        "@nestjs/core": "^12.0.4",
        "@nestjs/graphql": "^14.0.1",
        "@nestjs/platform-express": "^12.0.4",
        "@nestjs/testing": "^12.0.4",
        "@swc-node/register": "^1.12.1",
        "@swc/core": "^1.16.18",
        "@types/inquirer": "^8.2.13",
        "chokidar-cli": "^3.0.0",
        "eslint": "^9.39.5",
        "express": "^5.3.0",
        "graphql": "^16.14.2",
        "graphql-scalars": "^2.0.1",
        "prettier": "^3.9.10",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.1.3",
        "rxjs": "^7.8.2",
        "typescript": "^6.0.3",
        "unplugin-swc": "^2.0.0",
        "vitest": "^5.0.4"
    },
    "peerDependencies": {
        "@mikro-orm/cli": "^7.1.8",
        "@mikro-orm/core": "^7.1.8",
        "@mikro-orm/decorators": "^7.1.8",
        "@mikro-orm/migrations": "^7.1.8",
        "@mikro-orm/nestjs": "^7.0.0",
        "@mikro-orm/postgresql": "^7.1.8",
        "@nestjs/common": "^12.0.0",
        "@nestjs/core": "^12.0.0",
        "@nestjs/graphql": "^14.0.0",
        "@nestjs/platform-express": "^12.0.0",
        "graphql": "^16.6.0",
        "graphql-scalars": "^2.0.0",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.0.0"
    },
    "engines": {
        "node": ">=24.15.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    }
}
