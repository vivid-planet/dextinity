{
    "name": "@dextinity/cli",
    "version": "10.1.0",
    "description": "A collection of CLI tools for Dextinity projects",
    "repository": {
        "directory": "packages/cli",
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity"
    },
    "license": "BSD-2-Clause",
    "type": "commonjs",
    "main": "lib/index.js",
    "typings": "lib/index.d.ts",
    "bin": {
        "dextinity": "bin/dextinity.js"
    },
    "sideEffects": false,
    "files": [
        "bin/**/*.js",
        "lib/*"
    ],
    "scripts": {
        "build": "pnpm run clean && tsc -p tsconfig.build.json",
        "clean": "rimraf lib",
        "dev": "tsc --watch",
        "lint": "run-p lint:prettier lint:eslint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:prettier": "pnpm exec prettier --check '*.{ts,js,json,md,yml,yaml}'",
        "lint:tsc": "tsc",
        "test": "pnpm run test:unit",
        "test:unit": "vitest --run",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "commander": "^9.5.0",
        "js-yaml": "^4.1.1",
        "prettier": "^3.6.2",
        "ts-node": "^10.9.2"
    },
    "devDependencies": {
        "@dextinity/eslint-config": "workspace:*",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^24.13.3",
        "eslint": "^9.39.4",
        "npm-run-all2": "^8.0.4",
        "rimraf": "^6.1.2",
        "typescript": "^5.9.3",
        "vitest": "^4.1.8"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    }
}
