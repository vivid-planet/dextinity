{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":semanticCommitsDisabled",
        ":configMigration",
        "abandonments:recommended",
        "security:minimumReleaseAgeNpm",
        ":maintainLockFilesWeekly",
        ":automergeStableNonMajor"
    ],
    "automergeStrategy": "squash",
    "recreateWhen": "never",
    "packageRules": [
        {
            "groupName": "babel",
            "matchPackageNames": ["/@babel/*/"]
        },
        {
            "groupName": "lodash",
            "matchPackageNames": ["/^lodash.*/"]
        },
        {
            "extends": ["packages:eslint"],
            "groupName": "ESLint packages"
        },
        {
            "groupName": "Storybook",
            "matchPackageNames": ["/^@storybook/", "/^storybook/", "eslint-plugin-storybook"]
        },
        {
            "groupName": "Docusaurus",
            "matchPackageNames": ["/^@docusaurus/*/", "/@tsconfig/docusaurus/"]
        },
        {
            "groupName": "Final Form",
            "matchPackageNames": ["/final-form/", "/react-final-form/"],
            "enabled": false
        },
        {
            "matchPackageNames": ["@apollo/server"],
            "groupName": "@apollo/server"
        },
        {
            "matchPackageNames": ["@apollo/client", "graphql-tag"],
            "groupName": "@apollo/client and related dependencies"
        },
        {
            "groupName": "NestJS",
            "matchPackageNames": ["/^@nestjs/*/"]
        },
        {
            "groupName": "lodash",
            "matchPackageNames": ["/^lodash.*/", "/^@types/lodash.*/"]
        },
        {
            "groupName": "node",
            "matchPackageNames": ["node"],
            "rangeStrategy": "widen"
        },
        {
            "matchUpdateTypes": ["major"],
            "labels": ["major", "dependencies"]
        },
        {
            "groupName": "SWC",
            "matchPackageNames": ["@swc/plugin-emotion", "@vitejs/plugin-react-swc"]
        },
        {
            "groupName": "Next.js",
            "matchPackageNames": ["next", "@next/bundle-analyzer", "@next/eslint-plugin-next", "eslint-config-next"]
        },
        {
            "matchDepTypes": ["dependencies", "devDependencies"],
            "rangeStrategy": ["bump"]
        },
        {
            "matchDepTypes": ["peerDependencies"],
            "rangeStrategy": ["widen"]
        },
        {
            "enabled": false,
            "matchDepNames": ["node"],
            "matchDepTypes": ["engines", "uses-with"]
        },
        {
            "groupName": "Stylelint",
            "matchPackageNames": ["stylelint", "/^stylelint-*/"]
        },
        {
            "groupName": "OpenTelemetry",
            "matchPackageNames": ["@opentelemetry/**"]
        }
    ],
    "regexManagers": [
        {
            "fileMatch": ["^\\.env$"],
            "matchStrings": ["OAUTH2_PROXY_VERSION=(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)"],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "oauth2-proxy/oauth2-proxy",
            "versioningTemplate": "semver"
        }
    ],
    "labels": ["dependencies"],
    "baseBranches": ["main"],
    "nvm": {
        "enabled": false
    }
}
