{
    "name": "@dextinity/site-react-router",
    "version": "10.11.0",
    "description": "Dextinity Site package for React Router",
    "repository": {
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity",
        "directory": "packages/site/site-react-router"
    },
    "license": "BSD-2-Clause",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js"
        },
        "./node": {
            "types": "./lib/node.d.ts",
            "import": "./lib/node.js"
        },
        "./server": {
            "types": "./lib/server.d.ts",
            "import": "./lib/server.js"
        },
        "./vite": {
            "types": "./lib/vite/index.d.ts",
            "import": "./lib/vite/index.js"
        }
    },
    "files": [
        "lib/*"
    ],
    "scripts": {
        "build": "pnpm run clean && pnpm run generate-block-types && tsc -p tsconfig.build.json",
        "clean": "rimraf lib 'src/**/*.generated.ts'",
        "dev": "pnpm run clean && pnpm run generate-block-types && tsc -p tsconfig.build.json --watch --preserveWatchOutput",
        "generate-block-types": "dextinity generate-block-types",
        "lint": "pnpm run generate-block-types && run-p lint:prettier lint:eslint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ e2e/ playwright.config.ts '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:prettier": "pnpm exec prettier --check '*.{ts,mts,js,json,md,yml,yaml}'",
        "lint:tsc": "tsc --noEmit && pnpm run typegen:e2e && tsc --noEmit --project e2e/fixture",
        "test": "pnpm run test:unit",
        "test:e2e": "playwright test",
        "test:unit": "vitest --run",
        "test:watch": "vitest --watch",
        "typegen:e2e": "cd e2e/fixture && react-router typegen"
    },
    "dependencies": {
        "@dextinity/site-react": "workspace:*",
        "@hono/node-server": "^2.1.5",
        "@opentelemetry/api": "^1.9.1",
        "ioredis": "^5.11.1",
        "isbot": "^5.1.31",
        "jose": "^5.10.0",
        "lru-cache": "^11.5.3"
    },
    "devDependencies": {
        "@dextinity/cli": "workspace:*",
        "@dextinity/eslint-config": "workspace:*",
        "@playwright/test": "^1.64.1",
        "@react-router/dev": "^7.18.5",
        "@react-router/node": "^7.18.5",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.39.5",
        "hono": "^4.13.13",
        "jsdom": "^28.1.0",
        "npm-run-all2": "^9.0.4",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^7.18.5",
        "rimraf": "^6.1.3",
        "typescript": "^5.9.3",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "peerDependencies": {
        "@react-router/node": "^7.9.0",
        "hono": "^4.0.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-router": "^7.9.0",
        "vite": "^7.0.0 || ^8.0.0"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    }
}
