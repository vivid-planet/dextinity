{
    "name": "@dextinity/site-vite-rsc",
    "version": "10.10.0",
    "description": "Dextinity Site package for Vite with React Server Components",
    "repository": {
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity",
        "directory": "packages/site/site-vite-rsc"
    },
    "license": "BSD-2-Clause",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js"
        },
        "./node": {
            "types": "./lib/node.d.ts",
            "import": "./lib/node.js"
        },
        "./server": {
            "types": "./lib/server.d.ts",
            "import": "./lib/server.js"
        },
        "./vite": {
            "types": "./lib/vite/index.d.ts",
            "import": "./lib/vite/index.js"
        }
    },
    "files": [
        "lib/*"
    ],
    "scripts": {
        "build": "pnpm run clean && tsc -p tsconfig.build.json",
        "clean": "rimraf lib",
        "dev": "pnpm run clean && tsc -p tsconfig.build.json --watch --preserveWatchOutput",
        "lint": "run-p lint:prettier lint:eslint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ e2e/ playwright.config.ts '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:prettier": "pnpm exec prettier --check '*.{ts,mts,js,json,md,yml,yaml}'",
        "lint:tsc": "tsc --noEmit",
        "test": "pnpm run test:unit",
        "test:e2e": "playwright test",
        "test:unit": "vitest --run",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "@dextinity/site-react": "workspace:*",
        "@hono/node-server": "^2.1.5",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitejs/plugin-rsc": "0.5.38",
        "rsc-html-stream": "^0.0.8"
    },
    "devDependencies": {
        "@dextinity/eslint-config": "workspace:*",
        "@playwright/test": "^1.64.1",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.39.5",
        "hono": "^4.13.13",
        "jsdom": "^28.1.0",
        "npm-run-all2": "^9.0.4",
        "prettier": "^3.9.10",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-server-dom-webpack": "19.3.0",
        "rimraf": "^6.1.3",
        "typescript": "^5.9.3",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "peerDependencies": {
        "hono": "^4.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-server-dom-webpack": "^19.0.0",
        "vite": "^8.0.0"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    }
}
