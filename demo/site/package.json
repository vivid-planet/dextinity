{
    "name": "dextinity-demo-site",
    "private": true,
    "description": "Dextinity Site Demo Application",
    "type": "module",
    "scripts": {
        "build": "run-s intl:compile && run-p gql:types generate-block-types css:types && next build --webpack",
        "check-node-version": "check-node-version --node $(cat ../../.nvmrc)",
        "css:types": "typed-scss-modules src --nameFormat none --exportType default --aliasPrefixes.@src src",
        "css:types:watch": "pnpm run css:types --watch",
        "dev": "pnpm check-node-version && run-s intl:compile && run-p gql:types generate-block-types css:types && dotenv -e .env.secrets -e .env.local -e .env -e .env.site-configs -- node --inspect=localhost:9230 --max-old-space-size=768 server.ts",
        "export": "next export",
        "generate-block-types": "dextinity generate-block-types",
        "generate-block-types:watch": "chokidar -s \"block-meta.json\" -c \"pnpm generate-block-types\"",
        "gql:types": "graphql-codegen",
        "gql:watch": "graphql-codegen --watch",
        "intl:compile": "formatjs compile-folder --format simple --ast lang/dextinity-demo-lang/site lang-compiled/",
        "intl:extract": "formatjs extract \"src/**/*.{ts,tsx}\" --ignore '**/*.{test,spec}.{ts,tsx}' --ignore **/*.d.ts --out-file lang-extracted/en.json --format simple",
        "lint": "run-s intl:compile && run-p gql:types generate-block-types css:types && run-p lint:prettier lint:eslint lint:oxlint lint:tsc lint:style",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:oxlint lint:fix:prettier lint:fix:style",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:oxlint": "pnpm run lint:oxlint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:fix:style": "pnpm run lint:style --fix",
        "lint:oxlint": "oxlint --config oxlint.config.mts --max-warnings 0 src/ next.config.ts",
        "lint:prettier": "pnpm exec prettier --check \"*.{ts,js,json,md,yml,yaml,css,scss}\" \"src/**/*.{ts,tsx,js,jsx,json}\" \"!src/**/*.generated.ts\"",
        "lint:style": "pnpm exec stylelint '**/*.{css,scss}'",
        "lint:tsc": "pnpm exec next typegen && tsc --project . && tsc --project tsconfig.server.json",
        "serve": "NODE_ENV=production node server.ts",
        "test": "pnpm run test:unit",
        "test:unit": "vitest --run",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1161.0",
        "@base-ui/react": "^1.9.0",
        "@dextinity/mail-react": "workspace:*",
        "@dextinity/site-nextjs": "workspace:*",
        "@formatjs/cli": "^6.18.0",
        "@google-cloud/recaptcha-enterprise": "^7.3.0",
        "@next/bundle-analyzer": "^16.4.4",
        "@opentelemetry/api": "^1.10.0",
        "@opentelemetry/auto-instrumentations-node": "^0.82.0",
        "@opentelemetry/exporter-prometheus": "^0.300.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
        "@opentelemetry/instrumentation-runtime-node": "^0.37.0",
        "@opentelemetry/sdk-node": "^0.300.0",
        "cache-manager": "^7.2.9",
        "clsx": "^2.1.1",
        "embla-carousel": "9.0.0-rc04",
        "embla-carousel-accessibility": "9.0.0-rc04",
        "embla-carousel-auto-height": "9.0.0-rc04",
        "embla-carousel-react": "9.0.0-rc04",
        "filesize": "^11.0.29",
        "ioredis": "^6.0.0",
        "lru-cache": "^11.5.3",
        "mjml": "^5.4.1",
        "next": "^16.4.4",
        "nodemailer": "^10.3.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-focus-lock": "^2.13.7",
        "react-hook-form": "^7.91.0",
        "react-intl": "^12.1.4",
        "redraft": "^0.10.2",
        "usehooks-ts": "^3.1.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@babel/core": "^8.0.10",
        "@dextinity/cli": "workspace:*",
        "@dextinity/eslint-config": "workspace:*",
        "@dextinity/oxlint-config": "workspace:*",
        "@graphql-codegen/add": "^7.1.1",
        "@graphql-codegen/cli": "^7.4.6",
        "@graphql-codegen/named-operations-object": "^4.0.1",
        "@graphql-codegen/near-operation-file-preset": "^5.2.3",
        "@graphql-codegen/typescript": "^6.1.2",
        "@graphql-codegen/typescript-operations": "^6.1.10",
        "@parcel/watcher": "^2.6.0",
        "@types/grecaptcha": "^3.0.9",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "check-node-version": "^4.2.1",
        "chokidar-cli": "^3.0.0",
        "eslint": "^9.39.5",
        "graphql": "^16.14.2",
        "jsdom": "^30.1.2",
        "npm-run-all2": "^9.0.4",
        "oxlint": "1.89.0",
        "oxlint-tsgolint": "7.0.2004",
        "prettier": "^3.9.10",
        "sass": "^1.107.1",
        "schema-dts": "^2.1.0",
        "stylelint": "^17.16.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typed-scss-modules": "^8.1.1",
        "typescript": "^6.0.3",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^5.1.0"
    },
    "engines": {
        "node": "24"
    }
}
