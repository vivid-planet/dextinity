{
    "name": "@dextinity/cms-api",
    "version": "10.10.0",
    "description": "Dextinity CMS API package",
    "repository": {
        "directory": "packages/api/cms-api",
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity"
    },
    "license": "BSD-2-Clause",
    "type": "commonjs",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "bin/**/*.js",
        "lib/*",
        "!lib/*.tsbuildinfo"
    ],
    "scripts": {
        "build": "pnpm run clean && tsc -p tsconfig.build.json",
        "clean": "rimraf lib",
        "dev": "tsc --watch --preserveWatchOutput -p tsconfig.build.json",
        "generate-block-meta": "node -r @swc-node/register generate-block-meta.ts",
        "generate-block-meta:watch": "chokidar \"lib/\" -c \"pnpm generate-block-meta\"",
        "generate-schema": "node -r @swc-node/register generate-schema.ts",
        "generate-schema:watch": "chokidar \"lib/\" -c \"pnpm generate-schema\"",
        "lint": "run-p lint:prettier lint:eslint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:prettier": "pnpm exec prettier --check '*.{ts,js,json,md,yml,yaml}'",
        "lint:tsc": "tsc --noEmit",
        "test": "pnpm run test:unit",
        "test:unit": "vitest --run",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1149.0",
        "@aws-sdk/lib-storage": "^3.1149.0",
        "@azure-rest/ai-translation-text": "^1.0.2",
        "@azure/storage-blob": "^12.34.0",
        "@fast-csv/parse": "^5.0.8",
        "@golevelup/nestjs-discovery": "^7.1.0",
        "@hapi/accept": "^6.0.3",
        "@nestjs/mapped-types": "^12.0.0",
        "@opentelemetry/api": "^1.9.1",
        "@tiptap/core": "^3.32.0",
        "@tiptap/extension-subscript": "^3.32.0",
        "@tiptap/extension-superscript": "^3.32.0",
        "@tiptap/pm": "^3.32.0",
        "@tiptap/starter-kit": "^3.32.0",
        "content-disposition": "^3.0.0",
        "cron-parser": "^5.10.2",
        "dataloader": "^2.2.3",
        "date-fns": "^4.4.0",
        "dompurify": "^3.4.17",
        "exifr": "^7.1.3",
        "file-type": "^21.3.4",
        "graphql-parse-resolve-info": "^4.14.1",
        "html-to-text": "^10.0.1",
        "jose": "^5.10.0",
        "jsdom": "^30.1.2",
        "jszip": "^3.10.2",
        "jwks-rsa": "^4.1.0",
        "mime": "^3.0.0",
        "mime-db": "^1.54.0",
        "multer": "^2.4.0",
        "nodemailer": "^10.0.15",
        "openai": "^7.39.0",
        "probe-image-size": "^7.4.0",
        "request-ip": "^3.3.0",
        "rimraf": "^6.1.3",
        "slugify": "^1.6.9",
        "uuid": "^14.0.3",
        "uuid-by-string": "^4.0.0"
    },
    "devDependencies": {
        "@aws-sdk/types": "^3.974.6",
        "@dextinity/eslint-config": "workspace:*",
        "@golevelup/ts-vitest": "^4.0.0",
        "@kubernetes/client-node": "^1.4.0",
        "@mikro-orm/core": "^7.2.0",
        "@mikro-orm/decorators": "^7.2.0",
        "@mikro-orm/migrations": "^7.2.0",
        "@mikro-orm/nestjs": "^7.1.0",
        "@mikro-orm/postgresql": "^7.2.0",
        "@nestjs/common": "^12.0.4",
        "@nestjs/core": "^12.0.4",
        "@nestjs/graphql": "^14.0.1",
        "@nestjs/jwt": "^12.0.2",
        "@nestjs/platform-express": "^12.0.4",
        "@nestjs/testing": "^12.0.4",
        "@sentry/node": "^9.47.2",
        "@smithy/types": "^4.19.0",
        "@swc-node/register": "^1.12.1",
        "@swc/core": "^1.16.18",
        "@types/draft-js": "^0.11.20",
        "@types/express": "^5.0.6",
        "@types/html-to-text": "^9.0.4",
        "@types/inquirer": "^8.2.13",
        "@types/mime": "^2.0.3",
        "@types/mime-db": "^1.43.6",
        "@types/multer": "^2.3.0",
        "@types/node": "^24.19.2",
        "@types/probe-image-size": "^7.2.5",
        "@types/request-ip": "^0.0.41",
        "aws-sdk-client-mock": "^4.1.0",
        "chokidar-cli": "^3.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "eslint": "^9.39.5",
        "express": "^5.3.0",
        "graphql": "^16.14.2",
        "graphql-scalars": "^2.0.1",
        "nest-commander": "^3.21.0",
        "npm-run-all2": "^9.0.3",
        "prettier": "^3.9.10",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "typescript": "^6.0.3",
        "unplugin-swc": "^2.0.0",
        "vitest": "^5.0.4"
    },
    "peerDependencies": {
        "@kubernetes/client-node": "^1.0.0",
        "@mikro-orm/core": "^7.1.8",
        "@mikro-orm/decorators": "^7.1.8",
        "@mikro-orm/migrations": "^7.1.8",
        "@mikro-orm/nestjs": "^7.0.0",
        "@mikro-orm/postgresql": "^7.1.8",
        "@nestjs/common": "^12.0.0",
        "@nestjs/core": "^12.0.0",
        "@nestjs/graphql": "^14.0.0",
        "@nestjs/jwt": "^12.0.0",
        "@nestjs/platform-express": "^12.0.0",
        "@sentry/node": "^9.0.0",
        "class-transformer": "^0.5.0",
        "class-validator": "^0.14.0 || ^0.15.0",
        "express": "^5.0.0",
        "graphql": "^16.6.0",
        "graphql-scalars": "^2.0.0",
        "nest-commander": "^3.0.0",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.1.0"
    },
    "peerDependenciesMeta": {
        "@sentry/node": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=24.15.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    }
}
