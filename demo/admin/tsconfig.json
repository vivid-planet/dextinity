{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "inlineSources": true,
        "jsx": "react-jsx",
        "jsxImportSource": "@emotion/react",
        "module": "preserve",
        "moduleResolution": "bundler",
        "noEmit": true,
        "noUncheckedSideEffectImports": false,
        "paths": {
            "@src/*": ["./src/*"]
        },
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": "ESNext",
        "types": ["*"]
    },
    "include": ["src/**/*"]
}
