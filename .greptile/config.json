{
    "skipReview": "AUTOMATIC",
    "autoApprove": {
        "enabled": true
    },
    "excludeAuthors": ["vivid-planet-bot", "github-actions[bot]", "renovate[bot]"],
    "ignorePatterns": [
        "pnpm-lock.yaml",
        "**/CHANGELOG.md",
        "CHANGELOG.old.md",
        "**/__snapshots__/**",
        "**/generated/**",
        "**/schema.gql",
        "**/block-meta.json"
    ]
}
